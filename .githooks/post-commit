#!/bin/bash
# P-14: a commit made in the user's own session seals the reviewed state of the protected files.
# A commit from a Hermes process (only `bin/hcb repair apply` can make one) is sealed by apply itself.
if [[ -n "${HERMES_SESSION_KEY:-}" || -n "${HERMES_HOME:-}" ]]; then exit 0; fi
cd "$(git rev-parse --show-toplevel)" || exit 0
bin/hcb repair seal --by "commit $(git rev-parse --short HEAD)" >/dev/null 2>&1 || echo "post-commit: seal not written" >&2
exit 0
